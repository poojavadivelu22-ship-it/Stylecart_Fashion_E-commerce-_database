SELECT * FROM Orders;
SELECT * FROM Order_Item;
UPDATE Orders
SET Total_Amount = 2098.00
WHERE Order_ID = 1001;
SELECT Order_ID, Total_Amount
FROM Orders
WHERE Order_ID = 1001;
UPDATE Orders
SET Order_Status = 'Shipped',
    Shipping_Address = 'Chennai'
WHERE Order_ID = 1001;
SELECT *
FROM Orders
WHERE Order_ID = 1001;
UPDATE Order_Item
SET Quantity = 2,
    Subtotal = 1198.00
WHERE Order_Item_ID = 1;
SELECT *
FROM Order_Item
WHERE Order_Item_ID = 1;SELECT
    o.Customer_ID,
    o.Order_ID,
    o.Order_Date,
    o.Order_Status,
    o.Shipping_Address,
    oi.Product_ID,
    oi.Quantity,
    oi.Unit_Price,
    oi.Subtotal
FROM Orders o
JOIN Order_Item oi
    ON o.Order_ID = oi.Order_ID
ORDER BY o.Customer_ID, o.Order_Date;
SELECT
    o.Customer_ID,
    COUNT(DISTINCT o.Order_ID) AS Total_Orders,
    SUM(oi.Subtotal) AS Total_Amount
FROM Orders o
JOIN Order_Item oi
    ON o.Order_ID = oi.Order_ID
GROUP BY o.Customer_ID
ORDER BY o.Customer_ID;